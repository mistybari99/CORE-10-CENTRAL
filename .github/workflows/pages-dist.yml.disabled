# NOT ACTIVE: GitHub only runs *.yml/*.yaml, so this file does nothing as named.
# To activate (Owner only): see the PR description. Rename to pages-dist.yml AFTER
# setting Settings > Pages > Source = "GitHub Actions".
# Publishes ONLY an allowlist of app files; internal docs/SQL/tests are not copied.
name: Pages dist (allowlist publish)
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - name: Assemble dist/ (allowlist)
        run: |
          set -euo pipefail
          mkdir dist
          # Root app files only. Excludes internal/, tests/, v2/, *.md, *.sql, setup-*.html, audit-*.html
          for f in *.js *.css *.svg *.webp *.webmanifest *.json index.html owner.html business.html robots.txt .nojekyll; do
            if [ -e "$f" ]; then cp "$f" dist/; fi
          done
          cp -r data vendor dist/
          # v2/ is a legacy copy of the app; add `cp -r v2 dist/` only if it is still linked.
          # Safety net: fail the build if anything internal leaked into dist/
          if find dist -type f \( -name '*.sql' -o -name '*.md' -o -name 'setup-*.html' -o -name 'audit-*.html' \) | grep -q .; then
            echo "internal file found in dist"; exit 1
          fi
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
